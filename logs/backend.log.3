	oxidation_level VARCHAR, 
	cultural_significance TEXT, 
	cultural_significance_source VARCHAR, 
	country_of_origin VARCHAR NOT NULL, 
	subregions TEXT, 
	liquor_appearance TEXT NOT NULL, 
	liquor_aroma TEXT NOT NULL, 
