	country_of_origin VARCHAR NOT NULL, 
	subregions TEXT, 
	liquor_appearance TEXT NOT NULL, 
	liquor_aroma TEXT NOT NULL, 
	liquor_taste TEXT NOT NULL, 
	liquor_body_mouthfeel TEXT, 
	body_effect TEXT, 
	dry_leaf_appearance TEXT, 
	dry_leaf_aroma TEXT, 
	wet_leaf_appearance TEXT, 
	wet_leaf_aroma TEXT, 
	PRIMARY KEY (id), 
	UNIQUE (name)
)


