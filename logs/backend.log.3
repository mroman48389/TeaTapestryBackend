	body_effect TEXT, 
	dry_leaf_appearance TEXT, 
	dry_leaf_aroma TEXT, 
	wet_leaf_appearance TEXT, 
	wet_leaf_aroma TEXT, 
	PRIMARY KEY (id), 
	UNIQUE (name)
)


