CREATE TABLE tea_profiles (
	id INTEGER NOT NULL, 
	name VARCHAR NOT NULL, 
	alternative_names TEXT, 
	tea_type VARCHAR NOT NULL, 
	cultivars TEXT NOT NULL, 
