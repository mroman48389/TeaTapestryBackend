	user_id UUID NOT NULL, 
	tea_profile_id INTEGER NOT NULL, 
	created_at DATETIME NOT NULL, 
	updated_at DATETIME NOT NULL, 
	alternative_names TEXT NOT NULL, 
	cultivars TEXT NOT NULL, 
	processing TEXT NOT NULL, 
	oxidation_level TEXT NOT NULL, 
	cultural_significance TEXT NOT NULL, 
	cultural_significance_source TEXT NOT NULL, 
	subregions TEXT NOT NULL, 
	liquor_appearance TEXT NOT NULL, 
	liquor_aroma TEXT NOT NULL, 
	liquor_taste TEXT NOT NULL, 
	liquor_body_mouthfeel TEXT NOT NULL, 
	body_effect TEXT NOT NULL, 
	dry_leaf_appearance TEXT NOT NULL, 
	dry_leaf_aroma TEXT NOT NULL, 
	wet_leaf_appearance TEXT NOT NULL, 
	wet_leaf_aroma TEXT NOT NULL, 
	PRIMARY KEY (id), 
	FOREIGN KEY(user_id) REFERENCES users (id) ON DELETE CASCADE, 
	FOREIGN KEY(tea_profile_id) REFERENCES tea_profiles (id) ON DELETE CASCADE
)


